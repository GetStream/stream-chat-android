{
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "restaurant-booking-confirmation",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "restaurant-booking-confirmation",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "booking_confirm_title",
              "booking_confirm_image",
              "booking_confirm_details",
              "booking_confirm_note"
            ]
          },
          {
            "id": "booking_confirm_title",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "## ${/title}"
              }
            }
          },
          {
            "id": "booking_confirm_image",
            "component": "Image",
            "url": {
              "@path": "/imageUrl"
            },
            "fit": "cover",
            "variant": "mediumFeature"
          },
          {
            "id": "booking_confirm_details",
            "component": "Text",
            "text": {
              "@path": "/bookingDetails"
            }
          },
          {
            "id": "booking_confirm_note",
            "component": "Text",
            "text": {
              "@path": "/note"
            }
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "restaurant-booking-confirmation",
        "path": "/",
        "value": {
          "title": "Reservation confirmed for Xi'an Famous Foods",
          "bookingDetails": "Table for 4 on Fri, Oct 2, 7:00 PM GMT+1 with dietary notes: Vegetarian.",
          "imageUrl": "https://images.unsplash.com/photo-1612929633738-8fe44f7ec841?auto=format&fit=crop&w=900&q=80",
          "note": "We have shared your booking details with the restaurant. Expect a confirmation email shortly."
        }
      }
    }
  ]
}