default_platform :android
skip_docs

require 'json'
require 'net/http'
import 'Allurefile'

github_repo = ENV['GITHUB_REPOSITORY'] || 'GetStream/stream-chat-android'
test_flavor = 'stream-chat-android-compose-sample'
mock_server_driver_port = 4567
backend_test_class = 'io.getstream.chat.android.compose.tests.BackendTests'
e2e_tests_path = "#{test_flavor}/src/androidTestE2eDebug/kotlin/io/getstream/chat/android/compose"
e2e_coverage_dir = File.expand_path('test_output/e2e_coverage')
e2e_coverage_map_path = File.expand_path('test_output/e2e_coverage_map.json')
e2e_coverage_map_artifact = 'e2e-coverage-map'
e2e_selection_path = File.expand_path('test_output/e2e_selection.json')
is_localhost = !is_ci
@force_check = false
@impact = nil

before_all do |lane|
  @impact = impact_analysis
  if is_ci
    setup_ci
    setup_git_config
  end
end

lane :start_mock_server do |options|
  mock_server_repo = 'stream-chat-test-mock-server'
  stop_mock_server if is_localhost

  if options[:local_server]
    mock_server_repo = options[:local_server]
  else
    branch = options[:branch].to_s.empty? ? 'main' : options[:branch]
    sh("rm -rf #{mock_server_repo}") if File.directory?(mock_server_repo)
    sh("git clone -b #{branch} https://github.com/#{github_repo.split('/').first}/#{mock_server_repo}.git")
  end

  Dir.chdir(mock_server_repo) do
    FileUtils.mkdir_p('logs')
    sh("bundle exec ruby driver.rb > logs/driver.log 2>&1 &")
  end
end

lane :stop_mock_server do
  Net::HTTP.get_response(URI("http://localhost:#{mock_server_driver_port}/stop")) rescue nil
end

lane :run_sonar_analysis do |options|
  next unless is_check_required(sources: @impact[:sonar][:sources], force_check: @force_check, required_checks: @impact[:sonar][:checks])

  Dir.chdir('..') { sh('./gradlew sonar') }
end

lane :run_snapshot_test do |options|
  next unless is_check_required(sources: @impact[:ui][:sources], force_check: @force_check, required_checks: @impact[:ui][:checks])

  cmd = [
    './gradlew',
    'stream-chat-android-ui-uitests:executeScreenshotTests',
    '-Pandroid.testInstrumentationRunnerArguments.filter=io.getstream.chat.android.uitests.util.SnapshotTestFilter',
    '-Dorg.gradle.jvmargs="--add-opens java.base/java.nio=ALL-UNNAMED --add-opens java.base/java.nio.channels=ALL-UNNAMED --add-exports java.base/sun.nio.ch=ALL-UNNAMED"'
  ]
  cmd << '-Precord' unless options[:record].to_s.empty?
  Dir.chdir('..') { sh(cmd.join(' ')) }
end

lane :build_and_run_e2e_test do |options|
  build_e2e_test
  run_e2e_test(
    batch: options[:batch],
    batch_count: options[:batch_count],
    local_server: options[:local_server],
    mock_server_branch: options[:mock_server_branch],
    apk_folder_path: "../#{test_flavor}/build/outputs/apk",
    use_backend: options[:use_backend]
  )
end

lane :build_e2e_test do |options|
  next unless is_check_required(sources: @impact[:e2e][:sources], force_check: @force_check, required_checks: @impact[:e2e][:checks])

  gradle(
    tasks: [":#{test_flavor}:assembleE2eDebugAndroidTest", ":#{test_flavor}:assembleE2eDebug"],
    flags: options[:coverage] ? '--scan -Pe2eCoverage' : '--scan'
  )
end

desc 'Picks the e2e tests the pull request can affect and exposes how many CI batches they need'
lane :select_e2e_tests do |options|
  diff_base = options[:diff_base]
  # A merge queue entry is the queued pull requests on top of the base branch tip, so it takes the tests they affect.
  # A manual run's tip may be a "Merge develop" commit, which the selection would mistake for a pull request merge.
  run_all_reason = nil
  if is_ci && ENV['GITHUB_EVENT_NAME'] == 'merge_group'
    diff_base ||= JSON.parse(File.read(ENV.fetch('GITHUB_EVENT_PATH'))).dig('merge_group', 'base_sha')
    run_all_reason = 'the merge queue base is unknown' if diff_base.to_s.empty?
  elsif is_ci && ENV['GITHUB_EVENT_NAME'] != 'pull_request'
    run_all_reason = 'not a pull request'
  end
  # build_e2e_test skips the build under the same condition, so there is no test apk to read then.
  required = run_all_reason || is_check_required(sources: @impact[:e2e][:sources], force_check: @force_check, required_checks: @impact[:e2e][:checks])
  all_tests = required ? all_e2e_tests(test_apk_path: "../#{test_flavor}/build/outputs/apk/androidTest/e2e/debug/#{test_flavor}-e2e-debug-androidTest.apk") : []
  # The coverage map names tests Class/test, the instrumentation runs package.Class#test.
  tests_by_id = all_tests.to_h { |test| [test.split('.').last.sub('#', '/'), test] }
  tests = []
  reasons = []
  if run_all_reason
    UI.important("Running all #{all_tests.size} tests: #{run_all_reason}")
    tests = all_tests
    reasons = [run_all_reason]
  elsif required
    modules = e2e_modules
    selection = select_impacted_tests(
      all_tests: tests_by_id.keys,
      coverage_map: options[:coverage_map],
      coverage_map_artifact: e2e_coverage_map_artifact,
      diff_base: diff_base,
      changed_files: options[:changed_files]&.split(','),
      source_paths: modules.map { |name| "#{name}/src/main" } + ["#{test_flavor}/src/e2e"],
      test_paths: ["#{e2e_tests_path}/tests"],
      ignore_paths: ['**/*.md', '**/baseline-prof.txt'],
      run_all_paths: modules.map { |name| "#{name}/build.gradle.kts" } + [
        "#{e2e_tests_path}/tests/StreamTestCase.kt",
        "#{e2e_tests_path}/pages",
        "#{e2e_tests_path}/robots",
        "#{test_flavor}/src/androidTestE2eDebug/resources",
        'stream-chat-android-e2e-test',
        'buildSrc'
      ],
      # Changes to code nearly every test runs (launch, login, channel list) take one test per class; the nightly run covers the rest.
      hot_test_ratio: 0.9
    )
    tests = selection['tests'].map { |id| tests_by_id.fetch(id) }
    reasons = selection['reasons']
  else
    reasons = ['no e2e sources changed']
  end
  FileUtils.mkdir_p(File.dirname(e2e_selection_path))
  File.write(e2e_selection_path, JSON.pretty_generate(tests: tests, reasons: reasons))

  # Up to 8 batches, none bigger than an eighth of the suite, so a small selection takes fewer runners.
  max_batches = 8
  batch_size = [(all_tests.size / max_batches.to_f).ceil, 1].max
  batches = (0...[(tests.size / batch_size.to_f).ceil, max_batches].min).to_a
  UI.important("E2E batches: #{batches.size}")
  File.write(ENV['GITHUB_OUTPUT'], "e2e_batches=#{batches.to_json}\n", mode: 'a') if ENV['GITHUB_OUTPUT']
  batches
end

lane :run_e2e_test do |options|
  next unless is_check_required(sources: @impact[:e2e][:sources], force_check: @force_check, required_checks: @impact[:e2e][:checks])

  allure_results_path = 'allure-results'
  adb_test_results_path = '/sdcard/googletest/test_outputfiles'
  sh("rm -rf #{allure_results_path}")
  sh("adb shell rm -rf #{adb_test_results_path}/#{allure_results_path}")

  start_mock_server(local_server: options[:local_server], branch: options[:mock_server_branch])
  install_test_services
  update_emulator_settings
  upload_attachments

  stream_apk_folder_path = options[:apk_folder_path] || '..'
  stream_app_path = "#{stream_apk_folder_path}/e2e/debug/stream-chat-android-compose-sample-e2e-debug.apk"
  stream_test_path = "#{stream_apk_folder_path}/androidTest/e2e/debug/stream-chat-android-compose-sample-e2e-debug-androidTest.apk"
  sh("adb install -r #{stream_app_path}")
  sh("adb install -r #{stream_test_path}")

  app_package_name = 'io.getstream.chat.android.compose.sample.e2etest.debug'
  test_package_name = "#{app_package_name}.test"
  runner_package_name = 'io.qameta.allure.android.runners.AllureAndroidJUnitRunner'
  orchestrator_package_name = 'androidx.test.orchestrator/.AndroidTestOrchestrator'
  androidx_test_services_path = sh('adb shell pm path androidx.test.services').strip

  targeted_class = options[:test_class].to_s
  # The value is interpolated into a shell command, so only a class name is accepted,
  # optionally with a single method. A typo also fails here instead of in the shell.
  UI.user_error!("Invalid test_class: #{targeted_class}") unless
    targeted_class.empty? || targeted_class.match?(/\A[\w.$]+(#\w+)?\z/)

  if options[:use_backend]
    test_filter = "-e class #{backend_test_class}"
  elsif !targeted_class.empty?
    # Targeted run: a single class and no batching, so every batch job runs it and gives an
    # independent sample. Used to reproduce a failure that only shows on one API level.
    test_filter = "-e class #{targeted_class}"
  else
    run_tests_in_batches = batch_tests(
      batch: options[:batch],
      batch_count: options[:batch_count],
      tests: File.exist?(e2e_selection_path) ? JSON.parse(File.read(e2e_selection_path))['tests'] : nil,
      test_apk_path: stream_test_path
    )
    exclude_backend = "-e notClass #{backend_test_class}"
    test_filter = run_tests_in_batches.empty? ? exclude_backend : "#{run_tests_in_batches} #{exclude_backend}"
  end

  # The orchestrator runs every test in its own process, and the runner hands each one's coverage to the test
  # storage as coverage/<package>.<Class>#<test>.ec.
  adb_coverage_path = '/sdcard/googletest/internal_use/coverage'
  if options[:coverage]
    sh("adb shell rm -rf #{adb_coverage_path}")
    test_filter = "#{test_filter} -e coverage true -e coverageFilePath coverage/ -e useTestStorageService true"
  end

  result = sh(
    "adb shell 'CLASSPATH=#{androidx_test_services_path}' " \
    'app_process / androidx.test.services.shellexecutor.ShellMain am instrument -w -e clearPackageData true ' \
    "-e targetInstrumentation #{test_package_name}/#{runner_package_name} #{test_filter} #{orchestrator_package_name}"
  )

  sh("adb exec-out sh -c 'cd #{adb_test_results_path} && tar cf - #{allure_results_path}' | tar xvf - -C .") if is_ci
  stop_mock_server

  if options[:coverage]
    FileUtils.rm_rf(e2e_coverage_dir)
    FileUtils.mkdir_p(e2e_coverage_dir)
    sh("adb exec-out sh -c 'cd #{File.dirname(adb_coverage_path)} && tar cf - coverage' | tar xf - -C #{e2e_coverage_dir}")
    # The retry rule reruns a failed test in the same process, so a test fails here only when its last attempt failed.
    failed_tests = result.scan(/^\d+\) (\w+)\(([\w.$]+)\)\r?$/).map { |test, test_class| "#{test_class.split('.').last}/#{test}" }
    build_e2e_coverage_map(failed_tests: failed_tests)
  end

  UI.user_error!('Tests have failed!') if result.include?('Failures')
end

private_lane :build_e2e_coverage_map do |options|
  next UI.important('No e2e coverage was collected') if Dir.glob("#{e2e_coverage_dir}/**/*.ec").empty?

  build_test_coverage_map(
    coverage_dir: e2e_coverage_dir,
    class_dirs: e2e_class_dirs,
    output_path: e2e_coverage_map_path,
    previous_map_artifact: e2e_coverage_map_artifact,
    failed_tests: options[:failed_tests]
  )
end

# The compiled classes of the e2e app and the SDK modules it depends on, the modules a CI build of the app compiles.
private_lane :e2e_class_dirs do
  patterns = [
    '../stream-chat-android-*/build/tmp/kotlin-classes/{debug,e2eDebug}',
    '../stream-chat-android-*/build/intermediates/javac/{debug,e2eDebug}/*/classes',
    '../stream-chat-android-*/build/classes/{java,kotlin}/main'
  ]
  Dir.glob(patterns).map { |dir| File.expand_path(dir) }
end

private_lane :e2e_modules do
  modules = e2e_class_dirs.map { |dir| File.basename(dir.split('/build/').first) }.uniq.sort
  UI.user_error!('Build the e2e app first, its modules are read from the build output') if modules.empty?
  modules
end

# This lane can be used for local linting
lane :lint_e2e_test do |options|
  Dir.chdir('..') do
    ['stream-chat-android-e2e-test', 'stream-chat-android-compose-sample'].each do |target|
      sh("./gradlew :#{target}:spotlessApply :#{target}:detekt")
    end
  end
end

lane :upload_attachments do
  ['png', 'pdf'].each do |ext|
    [1, 2].each { |i| sh("adb push attachments/file.#{ext} /sdcard/Download/file_#{i}.#{ext}") }
  end
end

private_lane :all_e2e_tests do |options|
  install(tool: :test_parser)
  sh("java -jar test-parser.jar #{options[:test_apk_path]} ./")
  File.read('AllTests.txt').split.reject { |test| test.start_with?("#{backend_test_class}#") }
end

private_lane :batch_tests do |options|
  if options[:batch] && options[:batch_count]
    test_names = options[:tests] || all_e2e_tests(test_apk_path: options[:test_apk_path])
    batch = options[:batch].to_i
    batch_count = options[:batch_count].to_i
    # Round-robin split always yields exactly batch_count groups. Slicing by a rounded-up
    # size can yield fewer groups than batch_count, making the last batch nil and crashing.
    current_batch = test_names.select.with_index { |_, i| i % batch_count == batch }
    UI.user_error!("Batch #{batch} is empty: #{test_names.size} tests cannot fill #{batch_count} batches") if current_batch.empty?
    "-e class #{current_batch.join(',')}"
  else
    ''
  end
end

private_lane :install_test_services do
  FileUtils.mkdir_p('apks')
  device_api_level = sh('adb shell getprop ro.build.version.sdk').strip.to_i
  install(tool: :test_orchestrator, api_level: device_api_level)
  install(tool: :test_services, api_level: device_api_level)
  install(tool: :allurectl, chmod: true) if is_ci
end

private_lane :update_emulator_settings do
  sh('adb shell settings put system show_touches 1')
  sh('adb shell settings put system pointer_location 1')
end

desc 'Run fastlane linting'
lane :rubocop do
  next unless is_check_required(sources: @impact[:ruby][:sources], force_check: @force_check, required_checks: @impact[:ruby][:checks])

  sh('bundle exec rubocop')
end

lane :impact_analysis do
  {
    e2e: {
      sources: ['buildSrc', 'stream-chat-android'],
      checks: ['E2E result']
    },
    ui: {
      sources: ['stream-chat-android-ui'],
      checks: ['Run']
    },
    sonar: {
      sources: ['stream-chat-android-client/', 'stream-chat-android-compose/', 'stream-chat-android-core/', 'stream-chat-android-markdown-transformer/', 'stream-chat-android-ui-common/', 'stream-chat-android-ui-components/'],
      checks: ['Tests']
    },
    ruby: {
      sources: ['fastlane', 'Gemfile', 'Gemfile.lock'],
      checks: ['Rubocop']
    }
  }
end

private_lane :install do |options|
  case options[:tool]
  when :test_orchestrator
    v = '1.5.1'
    output = 'apks/orchestrator.apk'
    url = "https://dl.google.com/dl/android/maven2/androidx/test/orchestrator/#{v}/orchestrator-#{v}.apk"
  when :test_services
    v = '1.5.0'
    output = 'apks/test-services.apk'
    url = "https://dl.google.com/dl/android/maven2/androidx/test/services/test-services/#{v}/test-services-#{v}.apk"
  when :test_parser
    v = '2.2.1'
    output = 'test-parser.jar'
    url = "https://linkedin.jfrog.io/artifactory/open-source/com/linkedin/dextestparser/parser/#{v}/parser-#{v}-all.jar"
  when :allurectl
    v = '2.16.0'
    output = 'allurectl'
    arch = RbConfig::CONFIG['host_os'].include?('darwin') ? 'darwin_amd64' : 'linux_amd64'
    url = "https://github.com/allure-framework/allurectl/releases/download/#{v}/allurectl_#{arch}"
  else
    UI.user_error!('Provide a correct tool name.')
  end
  sh("wget -O #{output} '#{url}' 2>/dev/null") unless File.exist?(output)
  sh("adb install #{options[:api_level] >= 30 ? '--force-queryable' : ''} -r #{output}") if options[:api_level]
  sh("chmod +x #{output}") if options[:chmod]
end
